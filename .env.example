# SoFi llm-proxy configuration
# Refresh the key with:  llm-proxy-keys -q   (expires every ~3 days)
ANTHROPIC_BASE_URL=https://internal.sofitest.com/llm-proxy
ANTHROPIC_API_KEY=

# Models (override if the proxy uses different ids)
DEFAULT_MODEL=claude-sonnet-4-6
DEEP_MODEL=claude-opus-4-6

# Set to 1 to route the Strategist + Career Mentor to DEEP_MODEL (Opus)
DEEP_THINKERS=1

# Folder the agents read (PRDs, Brag Doc, notes). Default: ./docs
DOCS_DIR=docs

# Boardroom safety cap — max agent turns per @board run
MAX_BOARD_TURNS=7

# --- Weekly review delivery (all optional; unset channels are skipped) ---
# Slack: either an incoming webhook (simplest)...
SLACK_WEBHOOK_URL=
# ...or a bot token + channel
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Email (SMTP). For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PASS=<app password>
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# SMTP_TLS_NOVERIFY=1   # corp TLS escape hatch if cert verification fails
